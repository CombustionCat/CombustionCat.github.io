<%
var sites = site.posts.sort('-date').toArray()
  .filter(function(p){ return Array.isArray(p.location) && p.location.length === 2; })
  .map(function(p){
    return {
      name:        p.title || 'Untitled site',
      url:         encodeURI('/' + p.path),
      lat:         Number(p.location[0]),
      lng:         Number(p.location[1]),
      image:       p.image || null,
      darkness:    p.darkness ? Number(p.darkness) : null,
      low_horizons: Array.isArray(p.low_horizons)
        ? p.low_horizons.map(function(d){ return String(d).toLowerCase(); })
        : [],
      dark_regions: Array.isArray(p.dark_regions)
        ? p.dark_regions.map(function(d){ return String(d).toLowerCase(); })
        : [],
      summary: (p.summary && typeof p.summary === 'object') ? p.summary : {}
    };
  })
  .filter(function(s){ return isFinite(s.lat) && isFinite(s.lng); });
%>

<div class="proximity-page">
  <h1 class="sites-heading">Search by Proximity</h1>
  <p class="sites-lede">Find stargazing sites within a given distance from your location.</p>

  <div class="prox-mode-group">
    <label class="prox-mode-btn prox-mode-btn--active" id="mode-postal-lbl">
      <input type="radio" name="prox-mode" value="postal" checked hidden> Postal Code
    </label>
    <label class="prox-mode-btn" id="mode-place-lbl">
      <input type="radio" name="prox-mode" value="place" hidden> Place / Address
    </label>
  </div>

  <div class="prox-search-row">
    <!-- Postal code input -->
    <div id="postal-wrap" class="prox-field-wrap">
      <input id="postal-input" class="prox-input" type="text"
             placeholder="6-digit postal code e.g. 018956"
             maxlength="6" inputmode="numeric" pattern="[0-9]{6}">
    </div>

    <!-- Place name input with autocomplete -->
    <div id="place-wrap" class="prox-field-wrap" hidden>
      <div class="prox-ac-wrap">
        <input id="place-input" class="prox-input" type="text"
               placeholder="e.g. Bedok Reservoir, Jurong Lake"
               autocomplete="off" spellcheck="false">
        <ul class="prox-ac-list" id="ac-list" hidden role="listbox"></ul>
      </div>
    </div>

    <input id="radius-input" class="prox-input prox-input--km" type="number"
           value="5" min="1" max="100" title="Radius in km">
    <span class="prox-km-label">km</span>
    <button id="prox-search-btn" class="prox-btn">Search</button>
  </div>

  <p id="prox-status" class="prox-status" aria-live="polite"></p>

  <div class="sites-grid" id="prox-grid"></div>
  <p class="sites-empty" id="prox-empty" hidden>No sites found within that radius.</p>
</div>

<script>var SITES = <%- JSON.stringify(sites) %>;</script>
<script>
(function () {

  /* ── Haversine distance (km) ── */
  function dist(lat1, lng1, lat2, lng2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLng = (lng2 - lng1) * Math.PI / 180;
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLng / 2) * Math.sin(dLng / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  /* ── HTML escape ── */
  function esc(t) {
    var d = document.createElement('div');
    d.textContent = (t == null) ? '' : String(t);
    return d.innerHTML;
  }

  /* ── Card builder ── */
  function card(s, km) {
    var thumb = s.image
      ? '<a class="site-card-img" href="' + s.url + '"><img src="' + esc(s.image) + '" alt="' + esc(s.name) + '" loading="lazy"></a>'
      : '<a class="site-card-img site-card-img--none" href="' + s.url + '"><span>No photo yet</span></a>';
    var chips = '<span class="site-chip site-chip--dist">' + km.toFixed(1) + ' km</span>';
    if (s.darkness) chips += '<span class="site-chip site-chip--dark">Darkness ' + esc(s.darkness) + '</span>';
    if (s.low_horizons && s.low_horizons.length)
      chips += '<span class="site-chip">Horizons: ' + s.low_horizons.map(function(d){ return d[0].toUpperCase(); }).join(' ') + '</span>';
    if (s.dark_regions && s.dark_regions.length)
      chips += '<span class="site-chip">Dark: ' + s.dark_regions.map(function(d){ return d[0].toUpperCase(); }).join(' ') + '</span>';
    var extra = Object.keys(s.summary || {}).slice(0, 2)
      .map(function(k){ return '<li><b>' + esc(k) + '</b> ' + esc(s.summary[k]) + '</li>'; }).join('');
    return '<article class="site-card">' + thumb +
      '<div class="site-card-body">' +
        '<h2><a href="' + s.url + '">' + esc(s.name) + '</a></h2>' +
        '<div class="site-chips">' + chips + '</div>' +
        (extra ? '<ul class="site-card-meta">' + extra + '</ul>' : '') +
      '</div></article>';
  }

  /* ── UI elements ── */
  var grid      = document.getElementById('prox-grid');
  var empty     = document.getElementById('prox-empty');
  var status    = document.getElementById('prox-status');
  var postalWrap = document.getElementById('postal-wrap');
  var placeWrap  = document.getElementById('place-wrap');
  var postalIn  = document.getElementById('postal-input');
  var placeIn   = document.getElementById('place-input');
  var radiusIn  = document.getElementById('radius-input');
  var searchBtn = document.getElementById('prox-search-btn');
  var acList    = document.getElementById('ac-list');

  var mode = 'postal';
  var selectedLat = null, selectedLng = null;
  var acTimer = null;

  /* ── Mode toggle ── */
  var modeInputs = document.querySelectorAll('input[name="prox-mode"]');
  var postalLbl  = document.getElementById('mode-postal-lbl');
  var placeLbl   = document.getElementById('mode-place-lbl');

  function setMode(m) {
    mode = m;
    var isPostal = m === 'postal';
    postalWrap.hidden = !isPostal;
    placeWrap.hidden  = isPostal;
    postalLbl.classList.toggle('prox-mode-btn--active', isPostal);
    placeLbl.classList.toggle('prox-mode-btn--active', !isPostal);
    selectedLat = null; selectedLng = null;
    setStatus('');
    grid.innerHTML = '';
    empty.hidden = true;
  }

  Array.prototype.forEach.call(modeInputs, function (inp) {
    inp.addEventListener('change', function () { setMode(inp.value); });
  });
  postalLbl.addEventListener('click', function () { setMode('postal'); });
  placeLbl.addEventListener('click',  function () { setMode('place'); });

  /* ── Status helper ── */
  function setStatus(msg, isErr) {
    status.textContent = msg;
    status.style.color = isErr ? '#ff9c9c' : '#9aa6cf';
  }

  /* ── Render results ── */
  function showResults(origin) {
    var radius = parseFloat(radiusIn.value) || 5;
    var results = [];
    SITES.forEach(function (s) {
      var km = dist(origin.lat, origin.lng, s.lat, s.lng);
      if (km <= radius) results.push({ site: s, km: km });
    });
    results.sort(function (a, b) { return a.km - b.km; });
    grid.innerHTML = results.map(function (r) { return card(r.site, r.km); }).join('');
    empty.hidden = results.length !== 0;
    if (results.length) setStatus('Showing ' + results.length + ' site' + (results.length > 1 ? 's' : '') + ' within ' + radius + ' km.');
    else setStatus('');
  }

  /* ── OneMap postal geocode (Singapore) ── */
  function geocodePostal(code, cb) {
    var url = 'https://www.onemap.gov.sg/api/common/elastic/search?searchVal='
      + encodeURIComponent(code)
      + '&returnGeom=Y&getAddrDetails=Y&pageNum=1';
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.onload = function () {
      if (xhr.status !== 200) return cb('Could not reach OneMap API. Please try again.');
      try {
        var data = JSON.parse(xhr.responseText);
        if (!data.results || !data.results.length) return cb('No location found for postal code ' + code + '.');
        var r = data.results[0];
        cb(null, { lat: parseFloat(r.LATITUDE), lng: parseFloat(r.LONGITUDE), label: r.ADDRESS });
      } catch (e) {
        cb('Unexpected response from geocoding service.');
      }
    };
    xhr.onerror = function () { cb('Network error. Please check your connection.'); };
    xhr.send();
  }

  /* ── Nominatim place autocomplete ── */
  function fetchSuggestions(query) {
    var url = 'https://nominatim.openstreetmap.org/search?q='
      + encodeURIComponent(query)
      + '&format=json&countrycodes=sg&limit=6&addressdetails=0';
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.setRequestHeader('Accept-Language', 'en');
    xhr.onload = function () {
      if (xhr.status !== 200) return;
      try {
        var results = JSON.parse(xhr.responseText);
        showSuggestions(results);
      } catch (e) {}
    };
    xhr.send();
  }

  function showSuggestions(results) {
    acList.innerHTML = '';
    if (!results.length) { acList.hidden = true; return; }
    results.forEach(function (r) {
      var li = document.createElement('li');
      li.className = 'prox-ac-item';
      li.setAttribute('role', 'option');
      li.textContent = r.display_name;
      li.addEventListener('mousedown', function (e) {
        e.preventDefault();
        placeIn.value = r.display_name;
        selectedLat = parseFloat(r.lat);
        selectedLng = parseFloat(r.lon);
        acList.hidden = true;
        setStatus('');
      });
      acList.appendChild(li);
    });
    acList.hidden = false;
  }

  placeIn.addEventListener('input', function () {
    var q = placeIn.value.trim();
    selectedLat = null; selectedLng = null;
    clearTimeout(acTimer);
    if (q.length < 3) { acList.hidden = true; return; }
    acTimer = setTimeout(function () { fetchSuggestions(q); }, 320);
  });

  placeIn.addEventListener('blur', function () {
    setTimeout(function () { acList.hidden = true; }, 150);
  });

  /* ── Search ── */
  searchBtn.addEventListener('click', function () {
    grid.innerHTML = '';
    empty.hidden = true;

    if (mode === 'postal') {
      var code = postalIn.value.trim().replace(/\D/g, '');
      if (code.length !== 6) { setStatus('Please enter a valid 6-digit Singapore postal code.', true); return; }
      setStatus('Looking up postal code…');
      searchBtn.disabled = true;
      geocodePostal(code, function (err, origin) {
        searchBtn.disabled = false;
        if (err) { setStatus(err, true); return; }
        setStatus('Searching from ' + origin.label + '…');
        showResults(origin);
      });

    } else {
      if (selectedLat === null) {
        var raw = placeIn.value.trim();
        if (!raw) { setStatus('Please enter a place name and select a suggestion.', true); return; }
        setStatus('Geocoding place…');
        searchBtn.disabled = true;
        var url = 'https://nominatim.openstreetmap.org/search?q='
          + encodeURIComponent(raw)
          + '&format=json&countrycodes=sg&limit=1';
        var xhr = new XMLHttpRequest();
        xhr.open('GET', url, true);
        xhr.setRequestHeader('Accept-Language', 'en');
        xhr.onload = function () {
          searchBtn.disabled = false;
          try {
            var res = JSON.parse(xhr.responseText);
            if (!res.length) { setStatus('Could not locate "' + raw + '". Try a different name or pick a suggestion.', true); return; }
            selectedLat = parseFloat(res[0].lat);
            selectedLng = parseFloat(res[0].lon);
            showResults({ lat: selectedLat, lng: selectedLng });
          } catch (e) { setStatus('Geocoding failed. Please try again.', true); }
        };
        xhr.onerror = function () { searchBtn.disabled = false; setStatus('Network error.', true); };
        xhr.send();
        return;
      }
      showResults({ lat: selectedLat, lng: selectedLng });
    }
  });

  /* Allow pressing Enter in inputs to trigger search */
  [postalIn, placeIn, radiusIn].forEach(function (el) {
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') searchBtn.click();
    });
  });

})();
</script>
