<script>
(function () {
  var canvas = document.createElement('canvas');
  canvas.style.cssText = 'position:absolute;top:0;left:0;pointer-events:none;z-index:9999;';
  document.body.appendChild(canvas);

  var ctx = canvas.getContext('2d');
  var drawing = false;
  var paused = false;
  var hasMoved = false;
  var lastX = 0, lastY = 0;

  function setSize() {
    var w = Math.max(document.documentElement.scrollWidth, document.body.scrollWidth, window.innerWidth);
    var h = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, window.innerHeight);
    var imgData = null;
    if (canvas.width > 0 && canvas.height > 0) {
      try { imgData = ctx.getImageData(0, 0, canvas.width, canvas.height); } catch (e) {}
    }
    canvas.width = w;
    canvas.height = h;
    if (imgData) ctx.putImageData(imgData, 0, 0);
  }
  setSize();
  window.addEventListener('resize', setSize);

  function drawStar(x, y) {
    var outerR = 5, innerR = 2;
    ctx.save();
    ctx.fillStyle = 'rgba(255,255,255,0.95)';
    ctx.shadowColor = 'rgba(255,255,255,0.85)';
    ctx.shadowBlur = 7;
    ctx.beginPath();
    for (var i = 0; i < 10; i++) {
      var angle = (i * Math.PI / 5) - Math.PI / 2;
      var r = (i % 2 === 0) ? outerR : innerR;
      var px = x + r * Math.cos(angle);
      var py = y + r * Math.sin(angle);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  function drawSegment(x1, y1, x2, y2) {
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.72)';
    ctx.lineWidth = 1.2;
    ctx.lineCap = 'round';
    ctx.shadowColor = 'rgba(255,255,255,0.45)';
    ctx.shadowBlur = 3;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();
  }

  function elClass(el) {
    if (!el || !el.className) return '';
    return typeof el.className === 'string' ? el.className : (el.className.baseVal || '');
  }

  function isBlocked(el) {
    while (el && el.nodeType === 1) {
      var tag = el.tagName.toLowerCase();
      if (['a','button','input','textarea','select','label'].indexOf(tag) !== -1) return true;
      var id = el.id || '';
      var cls = elClass(el);
      if (id === 'header' || id === 'sidebar' || id === 'footer' || id === 'page-nav') return true;
      if (id === 'sg-map' || cls.indexOf('sg-map') !== -1 || cls.indexOf('leaflet') !== -1) return true;
      if (cls.indexOf('map-contact') !== -1 || id === 'ask' || id === 'ask-form') return true;
      el = el.parentElement;
    }
    return false;
  }

  function stopDraw() {
    if (!paused && hasMoved) drawStar(lastX, lastY);
    drawing = false;
    paused = false;
    hasMoved = false;
  }

  /* ── Mouse ── */
  document.addEventListener('mousedown', function (e) {
    if (e.button !== 0 || isBlocked(e.target)) return;
    drawing = true;
    paused = false;
    hasMoved = false;
    lastX = e.pageX;
    lastY = e.pageY;
    drawStar(lastX, lastY);
  });

  document.addEventListener('mousemove', function (e) {
    if (!drawing) return;
    var blocked = isBlocked(e.target);
    if (blocked) {
      if (!paused) {
        if (hasMoved) drawStar(lastX, lastY);
        paused = true;
      }
    } else if (paused) {
      lastX = e.pageX;
      lastY = e.pageY;
      drawStar(lastX, lastY);
      paused = false;
      hasMoved = false;
    } else {
      drawSegment(lastX, lastY, e.pageX, e.pageY);
      lastX = e.pageX;
      lastY = e.pageY;
      hasMoved = true;
    }
  });

  document.addEventListener('mouseup', function (e) {
    if (!drawing) return;
    if (!paused && hasMoved) drawStar(e.pageX, e.pageY);
    drawing = false;
    paused = false;
    hasMoved = false;
  });

  window.addEventListener('blur', function () { if (drawing) stopDraw(); });

  /* ── Touch ── */
  document.addEventListener('touchstart', function (e) {
    if (isBlocked(e.target)) return;
    var t = e.touches[0];
    drawing = true;
    paused = false;
    hasMoved = false;
    lastX = t.pageX;
    lastY = t.pageY;
    drawStar(lastX, lastY);
  }, { passive: true });

  document.addEventListener('touchmove', function (e) {
    if (!drawing) return;
    var t = e.touches[0];
    var elUnder = document.elementFromPoint(t.clientX, t.clientY);
    var blocked = isBlocked(elUnder);
    if (blocked) {
      if (!paused) {
        if (hasMoved) drawStar(lastX, lastY);
        paused = true;
      }
    } else if (paused) {
      lastX = t.pageX;
      lastY = t.pageY;
      drawStar(lastX, lastY);
      paused = false;
      hasMoved = false;
    } else {
      drawSegment(lastX, lastY, t.pageX, t.pageY);
      lastX = t.pageX;
      lastY = t.pageY;
      hasMoved = true;
    }
  }, { passive: true });

  document.addEventListener('touchend', function (e) {
    if (!drawing) return;
    var t = e.changedTouches[0];
    if (!paused && hasMoved) drawStar(t.pageX, t.pageY);
    drawing = false;
    paused = false;
    hasMoved = false;
  });
})();
</script>