<%
var photos = page.photos || [];
%>
<div class="gal-page">
  <% if (!photos.length) { %>
    <p style="color:#9aa6cf;text-align:center;padding:3rem 0">No photos yet.</p>
  <% } else { %>
  <div class="gal-grid">
    <% photos.forEach(function(p, idx) { %>
    <button class="gal-cell" data-idx="<%= idx %>" aria-label="<%= p.title || 'Photo' %>">
      <img src="<%- p.thumb || p.src %>" alt="<%= p.title || '' %>" loading="lazy">
    </button>
    <% }); %>
  </div>
  <% } %>
</div>

<!-- Lightbox modal -->
<div id="gal-modal" class="gal-modal" hidden aria-modal="true" role="dialog">
  <button class="gal-modal-close" id="gal-close" aria-label="Close">&times;</button>
  <button class="gal-modal-nav gal-prev" id="gal-prev" aria-label="Previous">&#8249;</button>
  <button class="gal-modal-nav gal-next" id="gal-next" aria-label="Next">&#8250;</button>
  <div class="gal-modal-inner">
    <div class="gal-modal-img-wrap">
      <img id="gal-img" src="" alt="">
    </div>
    <div class="gal-modal-info">
      <h2 id="gal-title" class="gal-info-title"></h2>
      <dl class="gal-info-dl" id="gal-dl"></dl>
    </div>
  </div>
</div>

<script>
(function () {
  var photos = <%- JSON.stringify(photos) %>;
  var modal  = document.getElementById('gal-modal');
  var img    = document.getElementById('gal-img');
  var title  = document.getElementById('gal-title');
  var dl     = document.getElementById('gal-dl');
  var cur    = 0;

  function show(idx) {
    cur = ((idx % photos.length) + photos.length) % photos.length;
    var p = photos[cur];
    img.src = p.src;
    img.alt = p.title || '';
    title.textContent = p.title || '';

    var fields = [
      ['Object',    p.object    || p.title],
      ['Telescope', p.telescope],
      ['Camera',    p.camera],
      ['Location',  p.location],
      ['Date',      p.date],
      ['Notes',     p.notes]
    ];
    dl.innerHTML = fields
      .filter(function(f){ return f[1]; })
      .map(function(f){
        return '<dt>' + f[0] + '</dt><dd>' + f[1] + '</dd>';
      }).join('');

    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('gal-close').focus();
  }

  function close() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.gal-cell').forEach(function(btn) {
    btn.addEventListener('click', function() { show(Number(btn.dataset.idx)); });
  });

  document.getElementById('gal-close').addEventListener('click', close);
  document.getElementById('gal-prev').addEventListener('click', function() { show(cur - 1); });
  document.getElementById('gal-next').addEventListener('click', function() { show(cur + 1); });

  modal.addEventListener('click', function(e) {
    if (e.target === modal) close();
  });

  document.addEventListener('keydown', function(e) {
    if (modal.hidden) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });
})();
</script>
