<%
var sites = site.posts.sort('-date').toArray()
  .filter(function(p){ return Array.isArray(p.location) && p.location.length === 2; })
  .map(function(p){
    return {
      name: p.title || 'Untitled site',
      url: encodeURI('/' + p.path),
      lat: Number(p.location[0]),
      lng: Number(p.location[1]),
      image: p.image || null,
      darkness: p.darkness ? Number(p.darkness) : null,
      low_horizons: Array.isArray(p.low_horizons)
        ? p.low_horizons.map(function(d){ return String(d).toLowerCase(); })
        : [],
      dark_regions: Array.isArray(p.dark_regions)
        ? p.dark_regions.map(function(d){ return String(d).toLowerCase(); })
        : [],
      summary: (p.summary && typeof p.summary === 'object') ? p.summary : {}
    };
  })
  .filter(function(s){ return isFinite(s.lat) && isFinite(s.lng); });
%>
<div class="sites-page">
  <h1 class="sites-heading">Every site</h1>
  <p class="sites-lede">Filter by darkness, horizons, or dark regions.</p>

  <input id="q" class="site-search" type="search" placeholder="Search sites&hellip;" aria-label="Search sites" style="margin-bottom:1rem">

  <div class="filter-groups">
    <div class="filter-group">
      <span class="filter-group-label">Overall Darkness</span>
      <label class="cb-label"><input type="checkbox" class="f-dark" value="1"><span>1</span></label>
      <label class="cb-label"><input type="checkbox" class="f-dark" value="2"><span>2</span></label>
      <label class="cb-label"><input type="checkbox" class="f-dark" value="3"><span>3</span></label>
    </div>
    <div class="filter-group">
      <span class="filter-group-label">Low Horizons</span>
      <label class="cb-label"><input type="checkbox" class="f-horizon" value="north"><span>N</span></label>
      <label class="cb-label"><input type="checkbox" class="f-horizon" value="south"><span>S</span></label>
      <label class="cb-label"><input type="checkbox" class="f-horizon" value="east"><span>E</span></label>
      <label class="cb-label"><input type="checkbox" class="f-horizon" value="west"><span>W</span></label>
    </div>
    <div class="filter-group">
      <span class="filter-group-label">Dark Regions</span>
      <label class="cb-label"><input type="checkbox" class="f-region" value="north"><span>N</span></label>
      <label class="cb-label"><input type="checkbox" class="f-region" value="south"><span>S</span></label>
      <label class="cb-label"><input type="checkbox" class="f-region" value="east"><span>E</span></label>
      <label class="cb-label"><input type="checkbox" class="f-region" value="west"><span>W</span></label>
    </div>
    <button id="reset" class="site-reset" type="button">Clear</button>
  </div>

  <div class="sites-grid" id="grid"></div>
  <p class="sites-empty" id="empty" hidden>No sites match those filters yet.</p>
</div>

<script>var SITES = <%- JSON.stringify(sites) %>;</script>
<script>
(function () {
  var grid = document.getElementById('grid');
  var empty = document.getElementById('empty');
  var q = document.getElementById('q');
  var reset = document.getElementById('reset');

  function checked(cls) {
    return Array.prototype.slice.call(document.querySelectorAll('.' + cls + ':checked'))
      .map(function(c){ return c.value; });
  }

  function esc(t) {
    var d = document.createElement('div');
    d.textContent = (t == null) ? '' : String(t);
    return d.innerHTML;
  }

  function card(s) {
    var thumb = s.image
      ? '<a class="site-card-img" href="' + s.url + '"><img src="' + esc(s.image) + '" alt="' + esc(s.name) + '" loading="lazy"></a>'
      : '<a class="site-card-img site-card-img--none" href="' + s.url + '"><span>No photo yet</span></a>';
    var chips = '';
    if (s.darkness) chips += '<span class="site-chip site-chip--dark">Darkness ' + esc(s.darkness) + '</span>';
    if (s.low_horizons && s.low_horizons.length)
      chips += '<span class="site-chip">Horizons: ' + s.low_horizons.map(function(d){ return d[0].toUpperCase(); }).join(' ') + '</span>';
    if (s.dark_regions && s.dark_regions.length)
      chips += '<span class="site-chip">Dark: ' + s.dark_regions.map(function(d){ return d[0].toUpperCase(); }).join(' ') + '</span>';
    var extra = Object.keys(s.summary || {}).slice(0, 2)
      .map(function(k){ return '<li><b>' + esc(k) + '</b> ' + esc(s.summary[k]) + '</li>'; })
      .join('');
    return '<article class="site-card">' + thumb +
      '<div class="site-card-body">' +
        '<h2><a href="' + s.url + '">' + esc(s.name) + '</a></h2>' +
        (chips ? '<div class="site-chips">' + chips + '</div>' : '') +
        (extra ? '<ul class="site-card-meta">' + extra + '</ul>' : '') +
      '</div></article>';
  }

  function apply() {
    var term = q.value.trim().toLowerCase();
    var darkVals = checked('f-dark').map(Number);
    var horizVals = checked('f-horizon');
    var regionVals = checked('f-region');

    var shown = SITES.filter(function(s) {
      if (term && s.name.toLowerCase().indexOf(term) === -1) return false;
      if (darkVals.length && darkVals.indexOf(s.darkness) === -1) return false;
      if (horizVals.length && !horizVals.some(function(d){ return (s.low_horizons || []).indexOf(d) !== -1; })) return false;
      if (regionVals.length && !regionVals.some(function(d){ return (s.dark_regions || []).indexOf(d) !== -1; })) return false;
      return true;
    });
    grid.innerHTML = shown.map(card).join('');
    empty.hidden = shown.length !== 0;
  }

  document.addEventListener('change', function(e){
    if (e.target.matches('.f-dark, .f-horizon, .f-region, #q')) apply();
  });
  q.addEventListener('input', apply);
  reset.addEventListener('click', function() {
    q.value = '';
    document.querySelectorAll('.f-dark, .f-horizon, .f-region').forEach(function(c){ c.checked = false; });
    apply();
  });
  apply();
})();
</script>
