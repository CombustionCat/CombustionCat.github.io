/* ====================================================
   Gallery
   ==================================================== */

.gallery-page {
  margin-top: -50px;
}
.img-list,
.gallery-list {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-start;
}
.img-column {
  display: flex;
  flex-direction: column-reverse;
}
.img-column a,
.gallery-column a {
  border-bottom: 0px;
}
.gallery-item {
  margin-bottom: -50px;
}
.gallery-item p {
  margin: -25px auto -10px;
  max-width: 50%;
  text-align: center;
  font-size: 15px;
  color: #e9ecfb;
  background: rgba(15, 21, 48, .5);
  border-radius: 7px;
  border: 1px solid rgba(180, 195, 255, .2);
  box-shadow: 0 8px 20px -8px rgba(0, 0, 0, .5);
}
.posts-expand .post-body .gallery-column a img {
  height: 250px;
  width: 300px;
  object-fit: cover;
}
@media (max-width: 767px) {
  .gallery-item p {
    min-width: 75px;
    font-size: 13px;
  }
}

/* ====================================================
   Dark blue night theme — base overrides
   ==================================================== */

/* ====================================================
   Header
   ==================================================== */

#banner { display: none; }

/* thin nav bar, blends with page background, no borders or line */
#header {
  background: #0a0e22;
  border: none;
  height: 48px;
}
#header:before, #header:after { display: none; }
#header-outer { border: none; overflow: visible; height: 48px; }
#header-inner { border: none; overflow: visible; }

/* logo — pull up to sit at top of the thin bar */
#logo {
  font-family: 'Fraunces', Georgia, serif;
  font-weight: 600;
  color: #f4b860;
  font-size: 1.45rem;
  letter-spacing: 0.4px;
  text-shadow: none;
  line-height: 48px;
}
#logo:hover { color: #f9c878; text-decoration: none; }
#logo-wrap { margin: 0; }
#header-title { top: 0; margin-top: 0; height: 48px; }

.logo-tagline {
  font-family: 'Reenie Beanie', cursive;
  font-size: 1.15rem;
  color: #ffffff;
  font-weight: 400;
  margin-left: 0.5rem;
  opacity: 0.85;
  white-space: nowrap;
  vertical-align: middle;
  line-height: 48px;
  display: inline;
}

/* nav links — compact padding to match 48px bar height */
.main-nav-link {
  font-weight: 300;
  letter-spacing: 1.1px;
  font-size: .82rem;
  text-transform: uppercase;
  color: rgba(233,236,251,.65);
  opacity: 1;
  text-shadow: none;
  border-radius: 6px;
  padding: 13px 9px !important;
  transition: background .15s ease, color .15s ease;
}
.main-nav-link:hover {
  color: #0a0e22;
  background: #f4b860;
  opacity: 1;
}

/* icon buttons (RSS, search) — match nav padding */
.nav-icon {
  color: rgba(233,236,251,.5);
  opacity: 1;
  text-shadow: none;
  padding: 13px 15px !important;
}
.nav-icon:hover { color: #e9ecfb; opacity: 1; }

/* hide post date and category display */
.article-date { display: none; }
.article-category { display: none; }
.article-category-link { display: none; }

body { color: #e9ecfb; }

#wrap { background: #0a0e22; }

/* remove white text-shadow from block-caption elements */
.article-date,
.article-category-link,
.article-category,
.archive-year,
.widget-title {
  text-shadow: none;
  color: #9aa6cf;
}

/* article cards */
.article-inner {
  background: #0f1530;
  box-shadow: 0 4px 24px rgba(0,0,0,.5);
  border-color: rgba(180,195,255,.12);
}

.archive-article-inner {
  background: #0f1530;
  box-shadow: 0 4px 12px rgba(0,0,0,.4);
  border-color: rgba(180,195,255,.12);
}

.article-title { color: #e9ecfb; }
a.article-title:hover { color: #9cc1ff; }

.article-entry { color: #e9ecfb; }

.archive-article-title { color: #e9ecfb; }
.archive-article-title:hover { color: #9cc1ff; }

.article-footer { border-color: rgba(180,195,255,.12); }
.article-footer a { color: #9aa6cf; }
.article-footer a:hover { color: #e9ecfb; }

/* article nav divider dot */
#article-nav:before {
  background: rgba(180,195,255,.2);
  box-shadow: none;
}
.article-nav-link-wrap {
  color: #9aa6cf;
  text-shadow: none;
}
.article-nav-link-wrap:hover { color: #e9ecfb; }
.article-nav-caption { color: rgba(180,195,255,.25); }

/* "Read More" */
.article-more-link a {
  background: #161d3d;
  color: #9cc1ff;
  text-shadow: none;
}
.article-more-link a:hover {
  background: #9cc1ff;
  color: #0a0e22;
  text-shadow: none;
}

/* share box */
.article-share-box { background: #0f1530; }
.article-share-links { background: #161d3d; }
.article-share-input {
  background: #0f1530;
  border-color: rgba(180,195,255,.15);
  color: #e9ecfb;
}

/* search form */
.search-form {
  background: #0f1530;
  box-shadow: 0 0 12px rgba(0,0,0,.5);
  overflow: visible;
}
.search-form-input { color: #e9ecfb; }

#search-form-wrap {
  overflow: visible;
  width: 200px;
  pointer-events: none;
}

#search-form-wrap.on {
  width: 200px;
  pointer-events: auto;
}

/* Search button — large, unambiguous hit target */
.nav-search-btn {
  float: left !important;
  display: block !important;
  width: 46px !important;
  height: 48px !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 48px !important;
  text-align: center !important;
  font-size: 16px !important;
  position: relative;
  z-index: 10;
}

.nav-ac-list {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  left: auto;
  background: #0d1228;
  border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px;
  box-shadow: 0 12px 32px rgba(0,0,0,.55);
  list-style: none;
  margin: 0;
  padding: .3rem 0;
  z-index: 10002;
  max-height: 220px;
  overflow-y: auto;
  min-width: 220px;
}

.nav-ac-item {
  padding: .55rem 1rem;
  font-size: .85rem;
  color: rgba(233,236,251,.8);
  cursor: pointer;
  transition: background .1s, color .1s;
}

.nav-ac-item:hover {
  background: rgba(180,195,255,.08);
  color: #f4b860;
}

/* sidebar */
.widget {
  color: #9aa6cf;
  text-shadow: none;
  background: #0f1530;
  box-shadow: 0 0 0 1px rgba(180,195,255,.12) inset;
  border-color: rgba(180,195,255,.12);
}
.widget a { color: #9cc1ff; }
.widget a:hover { color: #e9ecfb; }
.category-list-count,
.tag-list-count,
.archive-list-count { color: #9aa6cf; }

/* pagination */
#page-nav {
  background: #0f1530;
  box-shadow: 0 4px 12px rgba(0,0,0,.4);
  border-color: rgba(180,195,255,.12);
  color: #9aa6cf;
}
#page-nav a { color: #9aa6cf; }
#page-nav a:hover { background: #9cc1ff; color: #0a0e22; }
#page-nav .current { color: #e9ecfb; }
#page-nav .space { color: rgba(180,195,255,.2); }

/* footer */
#footer { border-color: rgba(180,195,255,.1); }

.footer-quote {
  font-family: 'Corinthia', cursive;
  font-size: 2rem;
  color: #e9ecfb;
  text-align: left;
  margin: 0 0 0.5rem;
  line-height: 1.5;
  opacity: 0.75;
  font-weight: 700;
}

/* ====================================================
   Map page
   ==================================================== */

.map-page { padding: 0; }

.map-eyebrow {
  font-family: "Space Mono", monospace;
  text-transform: uppercase;
  letter-spacing: .22em;
  font-size: 1.1rem;
  color: #f4b860;
  margin: 0 0 1rem;
}

.sg-map {
  height: 600px;
  width: 100%;
  border: 1px solid rgba(180,195,255,.12);
  border-radius: 12px;
  box-shadow: 0 14px 44px rgba(0,0,0,.5);
  background: #0f1530;
}

.map-hint {
  color: #9aa6cf;
  font-size: .9rem;
  margin: .6rem 0 0;
}

/* glowing star pins */
.star-pin .star-dot {
  display: block;
  width: 11px;
  height: 11px;
  margin: 4px auto;
  border-radius: 50%;
  background: #f4b860;
  box-shadow: 0 0 0 2px rgba(244,184,96,.22), 0 0 12px 3px rgba(244,184,96,.7);
  animation: twinkle 3.4s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 1; }
  50% { opacity: .55; }
}

/* leaflet popup dark style */
.sky-popup .leaflet-popup-content-wrapper {
  background: #161d3d;
  color: #e9ecfb;
  border: 1px solid rgba(180,195,255,.12);
  border-radius: 14px;
  box-shadow: 0 14px 44px rgba(0,0,0,.5);
}
.sky-popup .leaflet-popup-content { margin: 0; width: 250px !important; }
.sky-popup .leaflet-popup-tip {
  background: #161d3d;
  border: 1px solid rgba(180,195,255,.12);
}
.sky-popup a.leaflet-popup-close-button { color: #9aa6cf; padding: 6px 8px 0 0; }

.pop-img { display: block; }
.pop-img img {
  width: 100%; height: 130px; object-fit: cover; display: block;
  border-radius: 14px 14px 0 0;
}
.pop-title {
  display: block; font-weight: 600; font-size: 1.05rem;
  color: #e9ecfb; padding: .7rem .85rem .2rem;
}
.pop-summary {
  margin: .2rem .85rem .85rem;
  display: grid; grid-template-columns: auto 1fr;
  gap: .15rem .6rem; font-size: .82rem;
}
.pop-summary dt { color: #9aa6cf; }
.pop-summary dd { margin: 0; }

.sky-popup .pop-gmaps {
  display: block; font-size: .8rem;
  color: #7b9cff; padding: .1rem .85rem .5rem; text-decoration: none;
}
.sky-popup .pop-gmaps:hover { color: #aec3ff; }
.pop-chips {
  display: flex; flex-wrap: wrap; gap: .3rem;
  padding: .35rem .85rem .65rem;
}

/* contact form */
.map-contact {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(180,195,255,.1);
}
.map-contact h2 {
  font-size: 1.5rem; font-weight: bold;
  color: #e9ecfb; margin: 0 0 .4rem;
}
.map-lede { color: #9aa6cf; margin: 0 0 1.2rem; }

.ask-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .9rem;
}
.mf { display: flex; flex-direction: column; gap: .3rem; }
.mf-wide { grid-column: 1 / -1; }
.mf-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.ask-form label { font-size: .82rem; color: #9aa6cf; }
.ask-form input,
.ask-form textarea {
  background: #0f1530;
  border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px;
  color: #e9ecfb;
  padding: .65rem .8rem;
  font: inherit;
  resize: vertical;
}
.ask-form input:focus,
.ask-form textarea:focus {
  outline: none;
  border-color: #9cc1ff;
  box-shadow: 0 0 0 3px rgba(156,193,255,.15);
}
.ask-form button {
  background: #f4b860;
  color: #1a1300;
  border: 0;
  border-radius: 8px;
  padding: .65rem 1.2rem;
  font-weight: 600;
  font-size: .95rem;
  cursor: pointer;
}
.ask-form button:hover { filter: brightness(1.06); }
.form-status { margin: 0; font-size: .9rem; color: #9aa6cf; }
.form-status.ok { color: #86e0b0; }
.form-status.err { color: #ff9c9c; }

@media (max-width: 560px) {
  .ask-form { grid-template-columns: 1fr; }
}

/* ====================================================
   Site post — image carousel
   ==================================================== */

.site-carousel {
  position: relative;
  margin: 0 0 1.5rem;
  border-radius: 12px;
  overflow: hidden;
  background: #0f1530;
  user-select: none;
  height: 340px;
}
/* carousel-track and images are fully controlled by JS inline styles */
.carousel-track {
  position: relative;
  width: 100%;
  height: 340px;
}
.carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(10,14,34,.65);
  border: 1px solid rgba(180,195,255,.18);
  color: #e9ecfb;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  transition: background .15s, color .15s;
}
.carousel-btn:hover { background: #f4b860; color: #0a0e22; border-color: transparent; }
.carousel-prev { left: 10px; }
.carousel-next { right: 10px; }
.carousel-dots {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  z-index: 2;
}
.carousel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(233,236,251,.35);
  border: none;
  cursor: pointer;
  padding: 0;
  transition: background .15s;
}
.carousel-dot.active { background: #f4b860; }

.site-panorama {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 10px;
  margin: 1rem 0;
  display: block;
}

/* ====================================================
   Sites page
   ==================================================== */

.sites-page { padding: 0; }

.sites-heading {
  font-size: 2rem; font-weight: bold;
  color: #e9ecfb; margin: 0 0 .3rem;
}
.sites-lede { color: #9aa6cf; margin: .2rem 0 1.2rem; }

/* search + view toggle row */
.sites-controls {
  display: flex; align-items: center; gap: .75rem;
  margin-bottom: 1.2rem; flex-wrap: wrap;
}
.site-search {
  flex: 1; min-width: 180px;
  background: #0f1530; border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px; color: #e9ecfb; padding: .6rem .8rem; font: inherit;
}
.site-reset {
  background: transparent; border: 1px solid rgba(180,195,255,.15);
  color: #9aa6cf; border-radius: 8px; padding: .6rem 1rem;
  cursor: pointer; font: inherit;
}
.site-reset:hover { color: #e9ecfb; border-color: #9cc1ff; }

.view-toggle {
  display: flex; gap: 0; flex-shrink: 0;
  background: #0f1530; border: 1px solid rgba(180,195,255,.2);
  border-radius: 9px; overflow: hidden;
}
.view-btn {
  display: flex; align-items: center; gap: .4rem;
  background: transparent; border: none; border-right: 1px solid rgba(180,195,255,.2);
  color: #9aa6cf; padding: .5rem 1rem;
  cursor: pointer; font: inherit; font-size: .88rem;
  transition: color .15s, background .15s;
}
.view-btn:last-child { border-right: none; }
.view-btn:hover { color: #e9ecfb; background: rgba(156,193,255,.07); }
.view-btn--active { color: #f4b860; background: rgba(244,184,96,.1); }

.sites-grid {
  display: grid; gap: 1.1rem;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  margin-bottom: 1rem;
}
.sites-grid[hidden] { display: none; }
.site-card {
  background: #0f1530; border: 1px solid rgba(180,195,255,.12);
  border-radius: 14px; overflow: hidden;
  transition: transform .15s ease, border-color .15s ease;
}
.site-card:hover { transform: translateY(-3px); border-color: rgba(156,193,255,.4); }
.site-card-img { display: block; aspect-ratio: 16/10; background: #161d3d; }
.site-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.site-card-img--none { display: flex; align-items: center; justify-content: center; }
.site-card-img--none span { color: #9aa6cf; font-size: .85rem; }
.site-card-body { padding: .85rem .95rem 1rem; }
.site-card-body h2 { font-size: 1.05rem; font-weight: bold; color: #e9ecfb; margin: 0; }
.site-card-body h2 a { color: #e9ecfb; text-decoration: none; }
.site-card-body h2 a:hover { color: #9cc1ff; text-decoration: none; }
.site-chips { display: flex; gap: .4rem; flex-wrap: wrap; margin: .5rem 0 0; }
.site-chip {
  font-size: .72rem; color: #9aa6cf;
  border: 1px solid rgba(180,195,255,.18);
  border-radius: 999px; padding: .15rem .55rem;
}
.site-chip--dark { color: #f4b860; border-color: rgba(244,184,96,.35); }
.site-card-meta { list-style: none; margin: .6rem 0 0; padding: 0; font-size: .83rem; color: #9aa6cf; }
.site-card-meta b { color: #e9ecfb; font-weight: 500; }

.sites-empty { text-align: center; color: #9aa6cf; padding: 2rem; }

/* list / table view */
.sites-list {
  width: 100%; border-collapse: collapse; margin-bottom: 1rem;
  font-size: .9rem; color: #e9ecfb;
}
.sites-list th {
  text-align: left; font-size: .75rem; text-transform: uppercase;
  letter-spacing: .06em; color: #9aa6cf; font-weight: 500;
  padding: .5rem .75rem; border-bottom: 1px solid rgba(180,195,255,.15);
}
.sites-list th.sortable {
  cursor: pointer; user-select: none; white-space: nowrap;
}
.sites-list th.sortable:hover { color: #e9ecfb; }
.sites-list th.sorted { color: #f4b860; }
.sort-icon { font-size: .7rem; opacity: .8; }
.sites-list td {
  padding: .6rem .75rem; border-bottom: 1px solid rgba(180,195,255,.07);
  vertical-align: middle;
}
.sites-list tr:last-child td { border-bottom: none; }
.sites-list tr:hover td { background: rgba(156,193,255,.04); }
.sites-list td:first-child a { color: #e9ecfb; text-decoration: none; }
.sites-list td:first-child a:hover { color: #9cc1ff; }

/* checkbox filter groups */
.filter-groups {
  display: flex; gap: 1.2rem; flex-wrap: wrap; margin-bottom: 1.4rem;
}
.filter-group {
  display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
}
.filter-group-label {
  font-size: .78rem; color: #9aa6cf; font-weight: 500;
  text-transform: uppercase; letter-spacing: .06em; margin-right: .2rem;
  white-space: nowrap;
}
.cb-label {
  display: flex; align-items: center; gap: .3rem;
  font-size: .88rem; color: #e9ecfb; cursor: pointer;
  background: #0f1530; border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px; padding: .3rem .6rem;
  transition: border-color .15s;
}
.cb-label:hover { border-color: #9cc1ff; }
.cb-label input[type="checkbox"] { accent-color: #f4b860; cursor: pointer; }
.cb-label input[type="checkbox"]:checked + span { color: #f4b860; }

@media (prefers-reduced-motion: reduce) {
  .star-pin .star-dot { animation: none; }
  .site-card { transition: none; }
}

/* ====================================================
   Nav dropdown (Stargazing Sites)
   ==================================================== */

.nav-dropdown-wrap {
  position: relative;
  float: left;
}
.nav-dropdown-wrap::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  height: 12px;
}

.nav-has-dropdown {
  float: none;
  display: block;
}

.nav-caret {
  font-size: .7em;
  opacity: .6;
  margin-left: 2px;
}

.nav-dropdown {
  position: absolute;
  top: 48px;
  left: 0;
  background: #0d1228;
  border: 1px solid rgba(180,195,255,.15);
  border-radius: 10px;
  min-width: 210px;
  z-index: 10000;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-6px);
  transition: opacity .15s ease .4s, transform .15s ease .4s;
  box-shadow: 0 12px 36px rgba(0,0,0,.55);
}

.nav-dropdown-wrap:hover .nav-dropdown,
.nav-dropdown-wrap:focus-within .nav-dropdown {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
  transition: opacity .15s ease, transform .15s ease;
}

.nav-dropdown-item {
  display: block;
  padding: .7rem 1.1rem;
  color: rgba(233,236,251,.72);
  text-decoration: none;
  font-size: .88rem;
  font-weight: 300;
  letter-spacing: .5px;
  transition: color .1s, background .1s;
}

.nav-dropdown-item:first-child { border-radius: 10px 10px 0 0; }
.nav-dropdown-item:last-child  { border-radius: 0 0 10px 10px; }

.nav-dropdown-item:hover {
  color: #f4b860;
  background: rgba(180,195,255,.07);
  text-decoration: none;
}

.nav-dropdown-item + .nav-dropdown-item {
  border-top: 1px solid rgba(180,195,255,.08);
}

/* ====================================================
   Proximity search page
   ==================================================== */

.proximity-page { padding: 0; }

.prox-mode-group {
  display: flex;
  gap: .5rem;
  margin-bottom: 1.2rem;
}

.prox-mode-btn {
  padding: .45rem 1.1rem;
  border-radius: 8px;
  border: 1px solid rgba(180,195,255,.18);
  color: rgba(233,236,251,.55);
  font-size: .88rem;
  font-weight: 400;
  cursor: pointer;
  transition: all .15s;
  user-select: none;
}

.prox-mode-btn--active {
  background: rgba(180,195,255,.1);
  border-color: #9cc1ff;
  color: #e9ecfb;
}

.prox-search-row {
  display: flex;
  align-items: center;
  gap: .6rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.prox-field-wrap {
  flex: 1;
  min-width: 200px;
}

.prox-input {
  width: 100%;
  background: #0f1530;
  border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px;
  color: #e9ecfb;
  padding: .65rem .8rem;
  font: inherit;
  box-sizing: border-box;
}

.prox-input:focus {
  outline: none;
  border-color: #9cc1ff;
  box-shadow: 0 0 0 3px rgba(156,193,255,.15);
}

.prox-input--km {
  width: 72px;
  flex: none;
  text-align: center;
}

.prox-km-label {
  color: #9aa6cf;
  font-size: .9rem;
  white-space: nowrap;
}

.prox-btn {
  background: #f4b860;
  color: #1a1300;
  border: 0;
  border-radius: 8px;
  padding: .65rem 1.3rem;
  font-weight: 600;
  font-size: .95rem;
  cursor: pointer;
  white-space: nowrap;
  transition: filter .15s;
}

.prox-btn:hover:not(:disabled) { filter: brightness(1.07); }
.prox-btn:disabled { opacity: .55; cursor: default; }

/* Autocomplete */
.prox-ac-wrap { position: relative; }

.prox-ac-list {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background: #0d1228;
  border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px;
  box-shadow: 0 12px 32px rgba(0,0,0,.5);
  list-style: none;
  margin: 0;
  padding: .3rem 0;
  z-index: 10001;
  max-height: 220px;
  overflow-y: auto;
}

.prox-ac-item {
  padding: .55rem 1rem;
  font-size: .85rem;
  color: rgba(233,236,251,.8);
  cursor: pointer;
  line-height: 1.35;
  transition: background .1s, color .1s;
}

.prox-ac-item:hover {
  background: rgba(180,195,255,.08);
  color: #e9ecfb;
}

.prox-status {
  font-size: .9rem;
  color: #9aa6cf;
  margin: .3rem 0 1rem;
  min-height: 1.2em;
}

.site-chip--dist {
  color: #f4b860;
  border-color: rgba(244,184,96,.35);
  font-weight: 600;
}

@media (max-width: 560px) {
  .prox-search-row { flex-direction: column; align-items: stretch; }
  .prox-input--km  { width: 100%; }
}

/* ====================================================
   Desktop header — flex row so logo never collides with tabs
   ==================================================== */

/* Convert #header-outer to a flex row on desktop.
   #header-title becomes a normal in-flow item on the left;
   #header-inner (containing the tabs + icons) fills the rest. */
@media (min-width: 768px) {
  #header-outer {
    display: flex;
    align-items: center;
  }
  #header-title {
    position: static;
    top: auto;
    left: auto;
    width: auto;
    flex: 0 0 auto;
    height: 48px;
    text-align: left;
    margin-right: 6px;
  }
  #header-inner {
    flex: 1 1 auto;
    float: none;
    width: auto;
    overflow: visible;
    position: relative;
  }
  #main-nav {
    float: right;
    margin-left: 0;
    margin-right: 0;
  }
  #sub-nav {
    float: right;
    margin-right: -15px;
  }
}

/* ====================================================
   Mobile / Responsive improvements
   ==================================================== */

/* ── Tablet & below (≤767px): hamburger nav, header layout, map height ── */
@media (max-width: 767px) {
  /* Hide desktop nav links, show hamburger */
  .main-nav-link,
  .nav-dropdown-wrap {
    display: none !important;
  }
  #main-nav-toggle {
    display: block !important;
  }
  /* Remove negative margin so hamburger sits flush with the left edge */
  #main-nav {
    margin-left: 0;
  }
  /* Center the site title across the full header width so it doesn't
     collide with the hamburger icon or the right-side icons */
  #header-title {
    width: 100%;
    pointer-events: none;
  }
  #logo-wrap a {
    pointer-events: auto;
  }
  #logo {
    font-size: 1.1rem;
    letter-spacing: .1px;
  }
  /* Mobile nav drawer styles for tablet range (≤479px already has these
     from the theme; extend them up to 767px) */
  #mobile-nav {
    position: absolute;
    top: 0;
    left: 0;
    width: 280px;
    height: 100%;
    background: #0d1228;
    border-right: 1px solid rgba(180,195,255,.15);
  }
  .mobile-nav-link {
    display: block;
    color: #9aa6cf;
    text-decoration: none;
    padding: 14px 20px;
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(180,195,255,.08);
  }
  .mobile-nav-link:hover {
    color: #f4b860;
    background: rgba(180,195,255,.05);
    text-decoration: none;
  }
  .mobile-nav-sub {
    padding-left: 36px;
    font-size: .8rem;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    color: rgba(154,166,207,.75);
  }
  .mobile-nav-sub:hover {
    color: #f4b860;
  }
  /* Map: keep well under 3/4 of the viewport height */
  .sg-map {
    height: 360px;
    max-height: 70vh;
  }
}

/* ── Small phones (≤479px): font & spacing tweaks ── */
@media (max-width: 479px) {
  .logo-tagline { display: none; }
  .sites-heading {
    font-size: 1.5rem;
  }
  .map-eyebrow {
    font-size: .9rem;
  }
  .map-contact h2 {
    font-size: 1.2rem;
  }
  .filter-group {
    width: 100%;
  }
  .prox-field-wrap {
    min-width: 0;
  }
  /* Further reduce map on very small phones */
  .sg-map {
    height: 300px;
    max-height: 65vh;
  }
}

/* ====================================================
   Gallery page — Instagram-style grid + lightbox
   ==================================================== */

.gal-page { padding: 0; }

.gal-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 3px;
}

@media (max-width: 767px) {
  .gal-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 479px) {
  .gal-grid { grid-template-columns: repeat(2, 1fr); }
}

.gal-cell {
  display: block;
  aspect-ratio: 1;
  overflow: hidden;
  padding: 0;
  border: none;
  background: #0f1530;
  cursor: pointer;
  position: relative;
}

.gal-cell img,
.gal-cell-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .2s ease, opacity .2s ease;
}

.gal-cell:hover img,
.gal-cell:hover .gal-cell-video {
  transform: scale(1.05);
  opacity: .85;
}

/* Lightbox */
.gal-modal {
  position: fixed;
  inset: 0;
  background: rgba(5, 8, 16, .92);
  z-index: 20000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gal-modal[hidden] { display: none; }

.gal-modal-inner {
  display: flex;
  align-items: stretch;
  max-width: min(92vw, 1100px);
  max-height: 88vh;
  background: #0f1530;
  border: 1px solid rgba(180,195,255,.12);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0,0,0,.7);
}

.gal-modal-img-wrap {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #050810;
  max-width: 70%;
}

.gal-modal-img-wrap img {
  max-width: 100%;
  max-height: 88vh;
  object-fit: contain;
  display: block;
}

.gal-modal-info {
  flex: 0 0 280px;
  padding: 2rem 1.6rem;
  overflow-y: auto;
  border-left: 1px solid rgba(180,195,255,.1);
}

.gal-info-title {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.3rem;
  font-weight: 600;
  color: #e9ecfb;
  margin: 0 0 1.2rem;
}

.gal-info-dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: .35rem .8rem;
  margin: 0;
  font-size: .88rem;
}

.gal-info-dl dt {
  color: #9aa6cf;
  font-weight: 500;
  white-space: nowrap;
}

.gal-info-dl dd {
  color: #e9ecfb;
  margin: 0;
}

.gal-modal-close {
  position: fixed;
  top: 1.2rem;
  right: 1.4rem;
  background: rgba(15,21,48,.8);
  border: 1px solid rgba(180,195,255,.18);
  color: #e9ecfb;
  font-size: 1.6rem;
  line-height: 1;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 20001;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gal-modal-close:hover { background: #f4b860; color: #0a0e22; border-color: transparent; }

.gal-modal-nav {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(15,21,48,.7);
  border: 1px solid rgba(180,195,255,.18);
  color: #e9ecfb;
  font-size: 2rem;
  line-height: 1;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 20001;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gal-modal-nav:hover { background: #f4b860; color: #0a0e22; border-color: transparent; }
.gal-prev { left: 1rem; }
.gal-next { right: 1rem; }

@media (max-width: 767px) {
  .gal-modal-inner { flex-direction: column; max-width: 96vw; height: 90vh; overflow: hidden; }
  .gal-modal-img-wrap { max-width: 100%; height: 45vh; flex: 0 0 45vh; overflow: hidden; }
  .gal-modal-img-wrap img,
  .gal-modal-img-wrap video { max-height: 45vh !important; width: auto; max-width: 100%; }
  .gal-modal-info { flex: 1 1 0; min-height: 0; overflow-y: auto; border-left: none; border-top: 1px solid rgba(180,195,255,.1); padding: 1rem 1.2rem; }
}

/* ====================================================
   Astronomy Calendar
   ==================================================== */

.cal-page { padding: 0; }

.cal-hdr {
  display: flex;
  align-items: center;
  gap: .8rem;
  margin-bottom: 1.4rem;
}

.cal-month-lbl {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.5rem;
  color: #e9ecfb;
  margin: 0;
  flex: 1;
  text-align: center;
}

/* clickable month / year spans */
.cal-pick-trigger {
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 6px;
  transition: background .12s, color .12s;
  display: inline-block;
}
.cal-pick-trigger:hover { background: rgba(180,195,255,.12); color: #f4b860; }

/* fast-select dropdown — appended to <body>, always above everything */
.cal-picker {
  position: fixed;
  background: #0d1228;
  border: 1px solid rgba(180,195,255,.18);
  border-radius: 12px;
  padding: .5rem;
  z-index: 20100;
  box-shadow: 0 14px 40px rgba(0,0,0,.7);
}
.cal-picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .3rem;
}
.cal-picker-grid--2col { grid-template-columns: repeat(4, 1fr); }
.cal-picker-item {
  padding: .45rem .4rem;
  border-radius: 7px;
  border: none;
  background: transparent;
  color: rgba(233,236,251,.65);
  cursor: pointer;
  font-size: .85rem;
  font-family: inherit;
  text-align: center;
  transition: background .1s, color .1s;
}
.cal-picker-item:hover { background: rgba(180,195,255,.09); color: #e9ecfb; }
.cal-picker-item--active { background: rgba(244,184,96,.15); color: #f4b860; font-weight: 600; }

.cal-nav {
  background: #0f1530;
  border: 1px solid rgba(180,195,255,.15);
  border-radius: 8px;
  color: #e9ecfb;
  font-size: 1.8rem;
  line-height: 1;
  width: 40px;
  height: 40px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color .15s, color .15s;
}
.cal-nav:hover { border-color: #9cc1ff; color: #9cc1ff; }

.cal-today-btn {
  background: transparent;
  border: 1px solid rgba(180,195,255,.18);
  border-radius: 8px;
  color: #9aa6cf;
  font-size: .8rem;
  text-transform: uppercase;
  letter-spacing: .06em;
  padding: .4rem .9rem;
  cursor: pointer;
  transition: color .15s, border-color .15s;
}
.cal-today-btn:hover { color: #e9ecfb; border-color: #9cc1ff; }

/* ── Grid ── */
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 3px;
  margin-bottom: 1.2rem;
}

.cal-dh {
  text-align: center;
  font-size: .7rem;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: #9aa6cf;
  padding: .4rem 0 .5rem;
  font-weight: 500;
}

.cal-cell {
  background: #0f1530;
  border: 1px solid rgba(180,195,255,.07);
  border-radius: 6px;
  padding: .3rem .3rem .25rem;
  min-height: 82px;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 2px;
}

.cal-empty {
  background: rgba(15,21,48,.3);
  border-color: transparent;
}

.cal-cell-today {
  border-color: #f4b860 !important;
  background: rgba(244,184,96,.07) !important;
}

/* moon SVG + day number row — moon left of number, both right-aligned */
.cal-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 3px;
}

.cal-dn {
  font-size: .78rem;
  color: #9aa6cf;
  font-weight: 500;
  line-height: 1;
}
.cal-cell-today .cal-dn { color: #f4b860; font-weight: 700; }

/* shower dots */
.cal-dots {
  display: flex;
  gap: 2px;
  flex-wrap: wrap;
  padding-left: 1px;
}

.cal-dot {
  display: inline-block;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  flex-shrink: 0;
}

.cal-dot-peak {
  width: 7px;
  height: 7px;
  box-shadow: 0 0 4px currentColor;
}

/* planet event symbols */
.cal-evts {
  display: flex;
  flex-wrap: wrap;
  gap: 1px;
  padding-left: 1px;
}

.cal-pevt {
  font-size: .78rem;
  line-height: 1.2;
  cursor: default;
}

/* ── Bottom panels ── */
.cal-bottom {
  display: grid;
  grid-template-columns: auto 1fr 1fr;
  gap: 1.2rem;
  margin-top: .5rem;
}

.cal-panel { min-width: 0; }

.cal-section-title {
  font-size: .78rem;
  font-weight: 600;
  color: #9aa6cf;
  text-transform: uppercase;
  letter-spacing: .1em;
  margin: 0 0 .6rem;
}

/* moon phase legend */
.cal-moon-legend {
  display: flex;
  flex-direction: column;
  gap: .35rem;
}

.cal-leg-item {
  display: flex;
  align-items: center;
  gap: .45rem;
  font-size: .78rem;
  color: #9aa6cf;
  white-space: nowrap;
}

/* shared card style for showers + planet events */
.info-card {
  display: flex;
  align-items: flex-start;
  gap: .7rem;
  padding: .5rem .7rem;
  background: #0f1530;
  border: 1px solid rgba(180,195,255,.08);
  border-radius: 9px;
  margin-bottom: .4rem;
}

.info-swatch {
  flex-shrink: 0;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  margin-top: 3px;
  box-shadow: 0 0 5px currentColor;
}

.info-sym {
  flex-shrink: 0;
  font-size: 1rem;
  line-height: 1.3;
  margin-top: 1px;
}

.info-name {
  display: block;
  font-weight: 600;
  color: #e9ecfb;
  font-size: .88rem;
}

.info-sub {
  display: block;
  font-size: .77rem;
  color: #9aa6cf;
  margin-top: .15rem;
}

.cal-none { color: #9aa6cf; font-size: .85rem; margin: 0; }

@media (max-width: 900px) {
  .cal-bottom { grid-template-columns: 1fr 1fr; }
  .cal-panel:first-child { grid-column: 1 / -1; }
  .cal-moon-legend { flex-direction: row; flex-wrap: wrap; gap: .3rem .8rem; }
  .cal-leg-item { font-size: .72rem; }
}

@media (max-width: 560px) {
  .cal-bottom { grid-template-columns: 1fr; }
  .cal-panel:first-child { grid-column: auto; }
  .cal-cell { min-height: 64px; }
}
